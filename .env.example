VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA
# Credenciais secretas do Mercado Pago devem ficar SOMENTE no backend.
# Chave PUBLICA do Mercado Pago (teste ou producao, conforme ambiente).
VITE_MERCADOPAGO_PUBLIC_KEY=SUA_CHAVE_PUBLICA_MERCADOPAGO

# Ambiente de checkout: test (padrao), pilot (producao restrita) ou production.
# pilot utiliza as funcoes reais, mas habilita a interface apenas para o UUID autorizado.
# production encaminha para funcoes reais; liberar somente apos concluir a auditoria.
VITE_ELETRIPRO_PAYMENT_ENV=test
VITE_ELETRIPRO_PILOT_USER_ID=UUID_DA_CONTA_PILOTO
# Chave PUBLICA de producao; NUNCA usar Access Token aqui.
VITE_MERCADOPAGO_PROD_PUBLIC_KEY=SUA_CHAVE_PUBLICA_PRODUCAO
